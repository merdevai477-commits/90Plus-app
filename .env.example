# Server Configuration
NODE_ENV=development
PORT=3000
API_PREFIX=/api

# Database Configuration (Neon)
# Format: postgresql://username:password@host/database?sslmode=require
DATABASE_URL="postgresql://user:password@localhost:5432/dbname?sslmode=require"

# Cloudinary Configuration
# Get from: https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=your_cloud_name_here
CLOUDINARY_API_KEY=your_api_key_here
CLOUDINARY_API_SECRET=your_api_secret_here

# File Size Limits (in bytes)
MAX_AVATAR_SIZE=5242880
MAX_REEL_SIZE=104857600
MAX_THUMBNAIL_SIZE=2097152

# Supabase Configuration (Storage Only)
# Get from: https://supabase.com/dashboard/project/_/settings/api
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Storage Buckets
SUPABASE_STORAGE_BUCKET_AVATARS=avatars
SUPABASE_STORAGE_BUCKET_REELS=reels
SUPABASE_STORAGE_BUCKET_THUMBNAILS=thumbnails

# Clerk Authentication
# Get from: Clerk Dashboard > API Keys
CLERK_SECRET_KEY=sk_test_your_secret_key_here
CLERK_PUBLISHABLE_KEY=pk_test_your_publishable_key_here
# Production (Railway): sk_live_... and pk_live_... from Clerk Dashboard → Production instance

# Clerk Webhook Secret
# Get from: Clerk Dashboard > Webhooks > Your Endpoint > Signing Secret
CLERK_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# Football API Configuration
# Get from: https://www.api-football.com/
FOOTBALL_API_KEY=your_football_api_key_here

# World Cup news (website /news + GET /api/news/world-cup)
# Get from: https://newsapi.org/account
NEWS_API_KEY=your_news_api_key_here
# Upstream refresh every 2h = ~24 News API calls/day (2 langs × 12 refreshes)
NEWS_CACHE_TTL_MINUTES=120
NEWS_STALE_MAX_HOURS=6
NEWS_DAILY_BUDGET=90
NEWS_FEED_SIZE=15
NEWS_REFRESH_CRON=0 */2 * * *

# Sportmonks API Configuration
# Get from: https://www.sportmonks.com/
FOOTBALL_API_KEY="80c8953366a57143f19ef2466e9fe987"
FOOTBALL_API_PLAN="pro"
# Calendar: one fixtures?date= call per tick → cache + DB (default: today every 3min)
FOOTBALL_CALENDAR_SYNC_MS=60000
FOOTBALL_CALENDAR_PREFETCH_MS=1800000
# Live scores: fixtures?live=all (default: every 15s — triggers immediate match-event ingest)
FOOTBALL_LIVE_SYNC_MS=15000
# Favorite-match event ingest fallback poll (default: every 15s; live-sync triggers are immediate)
MATCH_EVENT_POLL_MS=15000

# When true, API-Football quota is used ONLY for World Cup (WORLD_CUP_LEAGUE_ID / WORLD_CUP_SEASON).
# Non-WC calendar/live sync jobs are skipped; DB/Redis cache reads are unchanged.
WORLD_CUP_ONLY_MODE=false

# 365Scores single-match live experiment (Canada vs Qatar by default)
# Serves World Cup fixtures + live details from 365Scores when enabled.
# Enable for maximum league coverage: 365 catalog (~800+ competitions), the
# /allscores/ calendar, and on-demand game-id resolution for lower tiers.
SCORES365_EXPERIMENT_ENABLED=true
# Legacy store-app hotfix: force fresh 365 lineups/events/stats (default ON with WC+365).
# Set WC_STORE_HOTFIX=false after the next App Store / Play Store release.
WC_STORE_HOTFIX=true
SCORES365_EXPERIMENT_GAME_ID=4627937
SCORES365_EXPERIMENT_FIXTURE_ID=1489387
SCORES365_COMPETITION_ID=5930
# 365Scores upstream (verified):
#   fixtures+gameIds → GET https://webws.365scores.com/web/games/fixtures/?competitions=5930&…
#   lineups/events/stats → GET https://webws.365scores.com/web/game/?gameId={GAME_ID}
#   named lineups+photos → GET https://webws.365scores.com/web/athletes/games/lineups?gameId={GAME_ID}
#   (no separate events URL — chronological events are on /web/game/ payload)
SCORES365_LANG_ID_AR=27
SCORES365_LANG_ID_EN=1
# When true, 365Scores always uses langId=1 (English) regardless of app language.
# Default false: upstream is queried in the user's language (ar=27, en=1), cached per langId.
SCORES365_FORCE_ENGLISH=false
SCORES365_DEFAULT_LANG=ar
SCORES365_CACHE_MS=3000
SCORES365_FIXTURES_CACHE_MS=60000
SCORES365_FIXTURES_LIVE_CACHE_MS=8000
# Community "Who Will Win?" % cache for match cards (default 20 min).
SCORES365_CROWD_PRED_CACHE_MS=1200000
# Max upcoming fixtures to enrich with crowd % per list request (default 36).
SCORES365_CROWD_PRED_MAX=80
# When true, /allscores/ returns only major leagues (default false — include all tiers).
SCORES365_ONLY_MAJOR_GAMES=false
# Max competitions to supplement per calendar day (default 801 = full catalog).
SCORES365_SUPPLEMENT_COMPETITION_LIMIT=801
# Competitions processed per fixtures batch tick (round-robin + today/tomorrow priority).
# Default 60 — higher covers the long-tail catalog faster; keep OTHER_LEAGUES_SYNC_ENABLED=true.
SCORES365_FIXTURES_SYNC_BATCH=60
# Max tracked competition IDs stored in Redis (default 2000).
SCORES365_TRACKED_COMPETITIONS_LIMIT=2000
# Max synthetic live fixtures to refresh score/minute each live tick (default 80).
SCORES365_SYNTHETIC_LIVE_BATCH=80
# Max live synthetic fixtures to warm lineups/stats/events each live tick (default 20).
# Favorites are prioritized first. Requires SCORES365_EXPERIMENT_ENABLED=true.
SCORES365_LIVE_DETAIL_MAX=20
# LMT: GET /api/football/cached/365/game/:gameId/lmt
# Default → HTML page that iframes official GetWidget?partnerid=…
# ?format=json → partnerId + widgetUrl (for app discovery)
# ?format=redirect → 302 to GetWidget
# App WebView brands GetWidget HTML like DD (pitchLogo replace). Optional:
# EXPO_PUBLIC_LMT_HIDE_PITCH_BRAND=true
# EXPO_PUBLIC_LMT_PITCH_LOGO_URL=https://…/90plus-pitch-logo.svg
# Cron: full 365 competitions catalog sync (default daily 04:00 UTC).
OTHER_LEAGUES_365_CATALOG_CRON=0 4 * * *
# Cron: per-competition fixtures batch — covers 2nd/3rd tier over time (default every 5 min).
OTHER_LEAGUES_365_FIXTURES_CRON=*/5 * * * *
# Master switch for non-WC calendar/live/365 workers (default true).
OTHER_LEAGUES_SYNC_ENABLED=true
# Emergency: skip boot-time heavy syncs (catalog/allscores/365live/fixtures kickoff,
# WC boot bulk, BackgroundPreload). Crons/intervals keep running. Set true to stop OOM storm.
STARTUP_SYNC_DISABLED=false

# Persistent player-stats cache TTLs (hours)
# Stats are cached in Postgres (PlayerStatsCache) to cut API-Football calls.
PLAYER_STATS_CACHE_TTL_HOURS=24
PLAYER_STATS_CACHE_TTL_LIVE_HOURS=1

# R2 is used for avatars/covers/thumbnails. Reels go to Mux directly (not R2).
#
# Cloudflare R2 — TWO buckets are used in production:
#  1. R2_BUCKET_NAME / R2_PUBLIC_URL  → GDPR data exports only (private bucket)
#  2. R2_MEDIA_BUCKET_NAME / R2_MEDIA_PUBLIC_URL → User media (avatars, covers,
#     thumbnails). This is the public bucket served via the custom Cloudflare domain.
# Get from: Cloudflare Dashboard > R2 > Manage R2 API Tokens
R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key

# GDPR exports bucket (private)
R2_BUCKET_NAME=90plus-exports
R2_PUBLIC_URL=https://exports.90plus.app

# Media bucket (public)
R2_MEDIA_BUCKET_NAME=90plus-media
R2_MEDIA_PUBLIC_URL=https://media.90plus.app

# MUX — Required for reel upload. All three must be set on Railway.
# Get from: Mux Dashboard > Settings > Access Tokens (token + secret)
# Webhook secret: Mux Dashboard > Settings > Webhooks > your endpoint
# Webhook URL: https://<your-api-host>/api/webhooks/mux
MUX_TOKEN_ID=your_mux_token_id
MUX_TOKEN_SECRET=your_mux_token_secret
MUX_WEBHOOK_SECRET=your_mux_webhook_signing_secret
# basic (default, free tier) | plus (paid Mux plan only)
MUX_VIDEO_QUALITY=basic

# ─── 90Plus AI Chat (Google Gemini OR AWS Bedrock OR OpenRouter) ────────────
# gemini  = Google Gemini API directly (recommended; supports AQ.* auth keys)
# bedrock = Claude Haiku on AWS credits
# openrouter = OpenRouter proxy (free/paid models)
AI_PROVIDER=gemini

# Google Gemini — chat (when AI_PROVIDER=gemini)
# Create key: https://aistudio.google.com/apikey (new keys use AQ.* format)
GEMINI_API_KEY=your_gemini_api_key_here
# Alias supported by Google SDKs:
# GOOGLE_API_KEY=your_gemini_api_key_here
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_CHAT_MODEL=gemini-3-flash-preview
GEMINI_CHAT_FALLBACK_MODEL=gemini-3.5-flash
AI_MODEL=gemini-3-flash-preview

# Daily quiz — Google Gemini direct (default when GEMINI_QUIZ_API_KEY or GEMINI_API_KEY set)
QUIZ_AI_PROVIDER=gemini
GEMINI_QUIZ_API_KEY=your_gemini_quiz_api_key_here
GEMINI_QUIZ_MODEL=gemini-3-flash-preview
GEMINI_QUIZ_FALLBACK_MODEL=gemini-3.5-flash
GEMINI_QUIZ_MAX_TOKENS=12000

# AWS Bedrock — chat only (when AI_PROVIDER=bedrock)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_key_here
AWS_SECRET_ACCESS_KEY=your_secret_here
# Optional: temporary STS credentials
# AWS_SESSION_TOKEN=
# Claude Haiku 4.5 on Bedrock (enable model access in AWS console first)
AWS_BEDROCK_CHAT_MODEL=anthropic.claude-haiku-4-5-20251001-v1:0

# ─── OpenRouter (quiz, translation, chat fallback when AI_PROVIDER=openrouter) ─
# All non-Bedrock AI features go through OpenRouter with different models per use case.
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Chat routing (production defaults — free tier, Arabic/English/dialect):
#  - PRIMARY: Qwen3 Next 80B (free) — best multilingual chat on OpenRouter free tier.
#  - FALLBACK: Gemma 4 26B (free) — when primary is rate-limited upstream.
OPENROUTER_CHAT_MODEL=qwen/qwen3-next-80b-a3b-instruct:free
OPENROUTER_CHAT_COMPLEX_MODEL=qwen/qwen3-next-80b-a3b-instruct:free
OPENROUTER_CHAT_FALLBACK_MODEL=google/gemma-4-26b-a4b-it:free

# Quiz generation model (smart, structured output, fact-accurate)
OPENROUTER_QUIZ_MODEL=google/gemini-2.5-flash
# Max completion tokens per quiz pack call (default 12000; lower if OpenRouter credits are tight)
OPENROUTER_QUIZ_MAX_TOKENS=12000

# Daily quiz campaign theme: DEFAULT | WORLD_CUP
# Aliases: WORLD_CUP_MODE, EURO_MODE, AFCON_MODE, CHAMPIONS_LEAGUE_MODE (future campaigns)
QUIZ_THEME=DEFAULT
# Optional: model for batch football name translation (defaults to OPENROUTER_CHAT_MODEL)
OPENROUTER_TRANSLATE_MODEL=google/gemini-2.5-flash

# Legacy aliases (for backward compatibility with chat.service.ts)
AI_API_KEY=your_openrouter_api_key_here
AI_BASE_URL=https://openrouter.ai/api/v1
AI_MODEL=qwen/qwen3-next-80b-a3b-instruct:free

# Max messages a single user can send per day
CHAT_DAILY_MESSAGE_LIMIT=10
# Complex chat model (football data + detailed answers). OPENROUTER_CHAT_COMPLEX_MODEL
# takes priority; OPENROUTER_CHAT_SIMPLE_MODEL is kept as a backward-compatible alias.
OPENROUTER_CHAT_COMPLEX_MODEL=google/gemini-3-flash-preview
OPENROUTER_CHAT_SIMPLE_MODEL=google/gemini-3-flash-preview

# Voice transcription (optional — 501 returned if not set)
# Use OpenAI Whisper or any compatible endpoint.
# AI_TRANSCRIBE_KEY=sk-...
# AI_TRANSCRIBE_BASE_URL=https://api.openai.com/v1

# ─── Push notifications (verification) ─────────────────────────────────────
# REDIS_URL is required for live fixture cache + Bull notification queues + Expo receipt checking.
# Local dev: redis://localhost:6379  |  Railway: use the Redis plugin URL
# REDIS_URL=redis://localhost:6379
# Expo Dashboard → Credentials: upload FCM v1 (Android) + APNs .p8 (iOS production).
# EAS projectId in front/app.json must match your Expo project.
# Run smoke test: npm run check:notifications
# Full round-trip (sends one push): set TEST_CLERK_USER_ID to a user with expoPushToken.
# TEST_CLERK_USER_ID=user_xxx
# SKIP_PUSH=1
# PUSH_TRACE_LOGS=true

# ─── Match event push pipeline ───────────────────────────────────────────────
# Poll interval for favorited live fixtures (default 15s). Also accepts MATCH_WATCHER_INTERVAL_MS.
# MATCH_EVENT_POLL_MS=15000
# Bull worker concurrency for match-event-push queue
# MATCH_EVENT_PUSH_CONCURRENCY=50
# Optional scale-out features (disabled by default — DB idempotency is sufficient for single instance)
# MATCH_EVENT_USE_REDIS_STREAM=false
# MATCH_EVENT_USE_LEADER_LOCK=false
# MATCH_EVENT_USE_SUBSCRIBER_INDEX=true
# INSTANCE_ID=worker-1
# Retention for match_events / cascading match_event_deliveries (days)
# MATCH_EVENT_RETENTION_DAYS=14

# Public share landing pages (/, /reels/:id, /@username) — same host as API root, not /api
SHARE_BASE_URL=https://90plus.pro

# Optional: direct Railway URL for internal scripts/debug (never shown to users)
# INTERNAL_API_URL=https://90plus-app-production-1808.up.railway.app/api

# ─── Android App Links (verified https share URLs) ───────────────────────────
# SHA-256 is required in /.well-known/assetlinks.json (defaults baked in if unset).
# SHA-1 is for Google Play Console / Firebase — set for your own reference.
ANDROID_RELEASE_SHA256=B9:AF:90:A5:F8:31:6E:B3:67:D2:94:EA:ED:ED:58:99:F6:BE:9C:FE:6A:9B:29:70:72:32:C4:D4:D0:07:C6:E8
ANDROID_RELEASE_SHA1=7D:17:3D:86:F4:B5:95:A3:AC:ED:23:3E:BD:B0:23:B3:CA:4F:F8:29
# AI_TRANSCRIBE_MODEL=whisper-1
