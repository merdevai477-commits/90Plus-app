// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// USER & AUTHENTICATION
// ============================================

model User {
  id           String   @id @default(uuid())
  clerkUserId  String?  @unique // Clerk User ID for authentication
  email        String   @unique
  username     String   @unique
  password     String?  // Nullable for OAuth users (deprecated with Clerk)
  displayName  String?
  avatar       String?
  avatarStoragePath String? // Path in Supabase Storage
  bio          String?
  coins        Int      @default(0)
  level        Int      @default(1)
  xp           Int      @default(0)
  isVerified   Boolean  @default(false)
  isDeveloper  Boolean  @default(false)
  favoriteTeam String?
  settings     Json?    @default("{}") // Stores preferences like biometricEnabled, language
  
  // Email verification
  emailVerified              Boolean   @default(false)
  emailVerificationToken     String?   @unique
  emailVerificationTokenExpires DateTime?
  
  // Moderation fields
  isSuspended    Boolean   @default(false)
  suspendedUntil DateTime?
  isBanned       Boolean   @default(false)
  bannedAt       DateTime?
  banReason      String?
  warningsCount  Int       @default(0)
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  sessions          Session[]
  refreshTokens     RefreshToken[]
  quizAttempts      QuizAttempt[]
  notifications     Notification[]
  reels             Reel[]
  comments          Comment[]
  likes             Like[]
  coinTransactions  CoinTransaction[]
  achievements      UserAchievement[]
  
  // Follow system
  followers  Follow[] @relation("UserFollowers")
  following  Follow[] @relation("UserFollowing")
  
  // Reports
  reportsCreated  Report[] @relation("ReportCreator")
  reportsReceived Report[] @relation("ReportedUser")
  reportsReviewed Report[] @relation("ReportReviewer")

  @@index([email])
  @@index([username])
  @@index([level])
  @@index([coins])
  @@index([createdAt])
  @@map("users")
}

model RefreshToken {
  id         String    @id @default(uuid())
  userId     String
  token      String    @unique @db.Text
  deviceInfo String?
  ipAddress  String?
  userAgent  String?   @db.Text
  isRevoked  Boolean   @default(false)
  expiresAt  DateTime
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model Session {
  id        String   @id
  userId    String
  expiresAt DateTime
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([userId])
  @@map("sessions")
}

// ============================================
// FOOTBALL DATA
// ============================================

model League {
  id        String   @id @default(uuid())
  name      String
  country   String
  logo      String?
  season    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  teams   Team[]
  matches Match[]

  @@index([country])
  @@index([season])
  @@map("leagues")
}

model Team {
  id       String   @id @default(uuid())
  name     String
  logo     String?
  country  String
  stadium  String?
  founded  Int?
  leagueId String?
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  league      League?  @relation(fields: [leagueId], references: [id])
  players     Player[]
  homeMatches Match[]  @relation("HomeTeam")
  awayMatches Match[]  @relation("AwayTeam")

  @@index([leagueId])
  @@index([country])
  @@index([name])
  @@map("teams")
}

model Player {
  id          String   @id @default(uuid())
  name        String
  photo       String?
  position    String
  number      Int?
  nationality String
  age         Int?
  teamId      String?
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  team  Team?        @relation(fields: [teamId], references: [id])
  stats PlayerStats?

  @@index([teamId])
  @@index([position])
  @@index([nationality])
  @@index([name])
  @@map("players")
}

model PlayerStats {
  id        String @id @default(uuid())
  playerId  String @unique
  pace      Int
  shooting  Int
  passing   Int
  dribbling Int
  defending Int
  physical  Int
  overall   Int

  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@index([overall])
  @@map("player_stats")
}

model Match {
  id         String      @id @default(uuid())
  homeTeamId String
  awayTeamId String
  homeScore  Int?
  awayScore  Int?
  status     MatchStatus
  leagueId   String
  matchDate  DateTime
  venue      String?
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  homeTeam Team   @relation("HomeTeam", fields: [homeTeamId], references: [id])
  awayTeam Team   @relation("AwayTeam", fields: [awayTeamId], references: [id])
  league   League @relation(fields: [leagueId], references: [id])

  @@index([status])
  @@index([matchDate])
  @@index([leagueId])
  @@index([homeTeamId])
  @@index([awayTeamId])
  @@map("matches")
}

enum MatchStatus {
  SCHEDULED
  LIVE
  FINISHED
  POSTPONED
  CANCELLED
}

// ============================================
// QUIZ SYSTEM
// ============================================

model QuizCategory {
  id          String   @id @default(uuid())
  name        String   @unique
  icon        String?
  description String?
  isLocked    Boolean  @default(false)
  unlockLevel Int      @default(1)
  createdAt   DateTime @default(now())

  questions QuizQuestion[]
  attempts  QuizAttempt[]

  @@index([isLocked])
  @@map("quiz_categories")
}

model QuizQuestion {
  id            String     @id @default(uuid())
  categoryId    String
  question      String     @db.Text
  options       String[]
  correctAnswer String
  difficulty    Difficulty
  points        Int        @default(10)
  createdAt     DateTime   @default(now())

  category QuizCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@index([categoryId])
  @@index([difficulty])
  @@map("quiz_questions")
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

model QuizAttempt {
  id             String   @id @default(uuid())
  userId         String
  categoryId     String
  score          Int
  totalQuestions Int
  coinsEarned    Int
  completedAt    DateTime @default(now())

  user     User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  category QuizCategory @relation(fields: [categoryId], references: [id])

  @@index([userId])
  @@index([categoryId])
  @@index([completedAt])
  @@index([score])
  @@map("quiz_attempts")
}

// ============================================
// COINS & GAMIFICATION
// ============================================

model CoinTransaction {
  id          String              @id @default(uuid())
  userId      String
  amount      Int
  type        CoinTransactionType
  description String?
  createdAt   DateTime            @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
  @@index([type])
  @@map("coin_transactions")
}

enum CoinTransactionType {
  QUIZ_REWARD
  DAILY_LOGIN
  ACHIEVEMENT
  PURCHASE
  ADMIN_GRANT
  REEL_REWARD
}

model Achievement {
  id          String            @id @default(uuid())
  name        String            @unique
  description String
  icon        String?
  category    AchievementCategory
  requirement Json // Flexible JSON for different requirements
  coinReward  Int               @default(0)
  xpReward    Int               @default(0)
  rarity      AchievementRarity
  createdAt   DateTime          @default(now())

  userAchievements UserAchievement[]

  @@index([category])
  @@index([rarity])
  @@map("achievements")
}

enum AchievementCategory {
  QUIZ_MASTER
  SOCIAL_BUTTERFLY
  COIN_COLLECTOR
  STREAK_KEEPER
  REEL_STAR
  TEAM_SUPPORTER
}

enum AchievementRarity {
  COMMON
  RARE
  EPIC
  LEGENDARY
}

model UserAchievement {
  id            String    @id @default(uuid())
  userId        String
  achievementId String
  progress      Int       @default(0)
  isCompleted   Boolean   @default(false)
  completedAt   DateTime?
  createdAt     DateTime  @default(now())

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievement Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)

  @@unique([userId, achievementId])
  @@index([userId])
  @@index([achievementId])
  @@index([isCompleted])
  @@map("user_achievements")
}

// ============================================
// SOCIAL FEATURES
// ============================================

model Follow {
  id          String   @id @default(uuid())
  followerId  String
  followingId String
  createdAt   DateTime @default(now())

  follower  User @relation("UserFollowers", fields: [followerId], references: [id], onDelete: Cascade)
  following User @relation("UserFollowing", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@index([followerId])
  @@index([followingId])
  @@map("follows")
}

model Reel {
  id        String   @id @default(uuid())
  userId    String
  videoUrl  String
  videoStoragePath String? // Path in Supabase Storage
  thumbnail String?
  thumbnailStoragePath String? // Path in Supabase Storage
  caption   String?  @db.Text
  views     Int      @default(0)
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  likes    Like[]
  comments Comment[]
  reports  Report[]

  @@index([userId])
  @@index([views])
  @@index([createdAt])
  @@map("reels")
}

model Like {
  id        String   @id @default(uuid())
  userId    String
  reelId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  reel Reel @relation(fields: [reelId], references: [id], onDelete: Cascade)

  @@unique([userId, reelId])
  @@index([userId])
  @@index([reelId])
  @@map("likes")
}

model Comment {
  id        String   @id @default(uuid())
  userId    String
  reelId    String
  content   String   @db.Text
  createdAt DateTime @default(now())

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  reel    Reel     @relation(fields: [reelId], references: [id], onDelete: Cascade)
  reports Report[]

  @@index([userId])
  @@index([reelId])
  @@index([createdAt])
  @@map("comments")
}

// ============================================
// NOTIFICATIONS & MODERATION
// ============================================

model Notification {
  id        String           @id @default(uuid())
  userId    String
  title     String
  message   String           @db.Text
  type      NotificationType
  isRead    Boolean          @default(false)
  data      Json?
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
  @@index([createdAt])
  @@index([type])
  @@map("notifications")
}

enum NotificationType {
  MATCH_UPDATE
  QUIZ_REWARD
  LEVEL_UP
  ACHIEVEMENT
  FOLLOW
  LIKE
  COMMENT
  GENERAL
}

model Report {
  id                String       @id @default(uuid())
  reporterId        String
  reportedUserId    String?
  reportedReelId    String?
  reportedCommentId String?
  type              ReportType
  reason            String       @db.Text
  status            ReportStatus @default(PENDING)
  reviewedBy        String?
  reviewedAt        DateTime?
  action            ReportAction @default(NO_ACTION)
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  reporter      User     @relation("ReportCreator", fields: [reporterId], references: [id])
  reportedUser  User?    @relation("ReportedUser", fields: [reportedUserId], references: [id])
  reportedReel  Reel?    @relation(fields: [reportedReelId], references: [id])
  reportedComment Comment? @relation(fields: [reportedCommentId], references: [id])
  reviewer      User?    @relation("ReportReviewer", fields: [reviewedBy], references: [id])

  @@index([reporterId])
  @@index([status])
  @@index([createdAt])
  @@index([type])
  @@map("reports")
}

enum ReportType {
  SPAM
  HARASSMENT
  INAPPROPRIATE
  FAKE_INFO
  COPYRIGHT
  OTHER
}

enum ReportStatus {
  PENDING
  REVIEWED
  RESOLVED
  REJECTED
}

enum ReportAction {
  NO_ACTION
  WARNING
  CONTENT_REMOVED
  USER_SUSPENDED
  USER_BANNED
}
