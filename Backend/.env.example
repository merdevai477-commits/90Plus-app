# Server Configuration
NODE_ENV=development
PORT=3000
API_PREFIX=/api

# Database Configuration
DATABASE_URL="postgresql://user:password@localhost:5432/dbname?sslmode=require"

# File Size Limits (in bytes)
MAX_AVATAR_SIZE=5242880
MAX_REEL_SIZE=52428800
MAX_THUMBNAIL_SIZE=2097152

# Clerk Authentication
CLERK_SECRET_KEY=sk_test_your_secret_key_here
CLERK_PUBLISHABLE_KEY=pk_test_your_publishable_key_here
CLERK_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# Cloudflare R2 Storage (ALL media: avatars, covers, reels, thumbnails)
# Get from: Cloudflare Dashboard > R2 > Manage R2 API Tokens
R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=90plus-storage
R2_PUBLIC_URL=https://pub-xxxx.r2.dev

# Cloudflare CDN URL (optional but RECOMMENDED for performance)
# How to set up:
# 1. Go to Cloudflare Dashboard > R2 > your bucket > Settings > Custom Domains
# 2. Add a custom domain e.g. cdn.90plus.app
# 3. Set CDN_URL=https://cdn.90plus.app
# If not set, falls back to R2_PUBLIC_URL (r2.dev domain - no CDN caching)
CDN_URL=https://cdn.90plus.app

# Football API
FOOTBALL_API_KEY=your_football_api_key_here
SPORTMONKS_API_KEY=your_sportmonks_api_key_here

# Redis (Upstash)
REDIS_URL=rediss://default:token@host:6379

# Email (SMTP)
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=resend
SMTP_PASS=your_resend_api_key
