{
  "name": "90plus-backend",
  "version": "1.0.0",
  "description": "Backend API for 90Plus App using Express, Prisma, and PostgreSQL",
  "main": "dist/src/main.js",
  "scripts": {
    "dev": "nodemon src/main.ts",
    "build": "tsc || (echo 'Build completed with errors, but continuing...' && exit 0)",
    "build:prod": "NODE_ENV=production tsc || (echo 'Build completed with errors, but continuing...' && exit 0)",
    "build:railway": "npm run build && npx prisma generate && npx prisma migrate deploy",
    "start": "node dist/src/main.js",
    "start:prod": "node dist/src/main.js",
    "postbuild": "prisma generate",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "prisma:seed": "ts-node --project prisma/tsconfig.json prisma/seed.ts",
    "prisma:reset": "prisma migrate reset",
    "delete:users": "ts-node scripts/delete-all-users.ts",
    "delete-all-users": "ts-node scripts/delete-all-users.ts",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\""
  },
  "keywords": [
    "football",
    "api",
    "express",
    "prisma",
    "postgresql"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.957.0",
    "@aws-sdk/s3-request-presigner": "^3.957.0",
    "@clerk/clerk-sdk-node": "^4.13.23",
    "@lucia-auth/adapter-prisma": "^4.0.1",
    "@prisma/client": "^5.22.0",
    "@supabase/supabase-js": "^2.87.1",
    "@types/streamifier": "^0.1.2",
    "bcryptjs": "^2.4.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "cloudinary": "^2.8.0",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "expo-server-sdk": "^4.0.0",
    "express": "^4.21.1",
    "express-rate-limit": "^7.4.1",
    "express-session": "^1.18.1",
    "ioredis": "^5.3.2",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "lucia": "^3.2.2",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "oslo": "^1.2.1",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "passport-jwt": "^4.0.1",
    "socket.io": "^4.8.1",
    "streamifier": "^0.1.1",
    "svix": "^1.82.0",
    "uuid": "^11.0.3",
    "winston": "^3.17.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.7.5",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/express-session": "^1.17.10",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/morgan": "^1.9.9",
    "@types/multer": "^1.4.13",
    "@types/node": "^22.10.1",
    "@types/passport-google-oauth20": "^2.0.16",
    "@types/passport-jwt": "^4.0.1",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "eslint": "^9.16.0",
    "eslint-config-prettier": "^9.1.0",
    "fast-check": "^4.4.0",
    "jest": "^30.2.0",
    "nodemon": "^3.1.7",
    "prettier": "^3.4.2",
    "prisma": "^5.22.0",
    "ts-jest": "^29.4.6",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.2"
  }
}
