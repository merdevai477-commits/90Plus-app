{
  "name": "90plus-backend",
  "version": "1.0.0",
  "description": "Backend API for 90Plus App using Express, Prisma, and PostgreSQL",
  "main": "dist/src/main.js",
  "scripts": {
    "dev": "nodemon src/main.ts",
    "build": "tsc && npm run copy:public || echo Build completed with errors",
    "build:prod": "NODE_ENV=production tsc && npm run copy:public || echo Build completed with errors",
    "build:railway": "npm run build && npx prisma generate && npx prisma db push --accept-data-loss",
    "build:reliability": "npm run reliability:check && npm run build",
    "copy:public": "node -e \"const fs = require('fs'); const path = require('path'); const src = 'public'; const dest = 'dist/public'; if (fs.existsSync(src)) { fs.mkdirSync(dest, { recursive: true }); fs.readdirSync(src).forEach(file => { fs.copyFileSync(path.join(src, file), path.join(dest, file)); }); console.log('✅ Public folder copied'); } else { console.log('⚠️ Public folder not found'); }\"",
    "verify:build": "node -e \"const fs = require('fs'); const exists = fs.existsSync('dist/src/routes/quiz.routes.js'); console.log(exists ? '✅ quiz.routes.js exists' : '❌ quiz.routes.js missing'); process.exit(exists ? 0 : 1);\"",
    "start": "node dist/src/main.js",
    "start:prod": "node dist/src/main.js",
    "postbuild": "prisma generate",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "test:adversarial": "jest tests/adversarial.test.ts --runInBand",
    "reliability:check": "npm run reliability:routes && npm run reliability:memory",
    "reliability:routes": "node scripts/route-coverage-lock.js",
    "reliability:memory": "node scripts/memory-leak-detector.js",
    "reliability:full": "npm run reliability:check && npm run test:adversarial",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "prisma:seed": "ts-node --project prisma/tsconfig.json prisma/seed.ts",
    "prisma:reset": "prisma migrate reset",
    "seed:transfers": "ts-node src/scripts/seed-transfers.ts",
    "seed:transfers:force": "ts-node src/scripts/seed-transfers.ts --force",
    "delete:users": "ts-node scripts/delete-all-users.ts",
    "delete-all-users": "ts-node scripts/delete-all-users.ts",
    "export:questions": "ts-node scripts/export-questions.ts",
    "export:answers": "ts-node scripts/export-answers.ts",
    "verify:user": "ts-node src/scripts/verify-user.ts",
    "verify:user:railway": "ts-node src/scripts/verify-user-railway-direct.ts",
    "list:users": "ts-node src/scripts/list-users.ts",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "test:r2": "ts-node test-r2-reels.ts",
    "test:r2:reels": "ts-node test-r2-reels.ts",
    "test:r2:service": "ts-node test-r2-service.ts",
    "test:r2:quick": "ts-node quick-test-r2.ts",
    "check:r2": "ts-node check-r2-bucket.ts",
    "test:mux": "ts-node --project tsconfig.scripts.json scripts/test-mux-upload.ts",
    "test:mux:direct": "ts-node --project tsconfig.scripts.json scripts/test-mux-direct.ts"
  },
  "keywords": [
    "football",
    "api",
    "express",
    "prisma",
    "postgresql"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.957.0",
    "@aws-sdk/s3-request-presigner": "^3.957.0",
    "@callstack/liquid-glass": "^0.7.1",
    "@clerk/express": "^2.0.8",
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "@lucia-auth/adapter-prisma": "^4.0.1",
    "@mux/mux-node": "^12.8.1",
    "@prisma/client": "^5.22.0",
    "@sentry/node": "^10.42.0",
    "@sentry/profiling-node": "^10.42.0",
    "@types/bull": "^3.15.9",
    "@types/fluent-ffmpeg": "^2.1.28",
    "@types/node-cron": "^3.0.11",
    "@types/node-fetch": "^2.6.13",
    "async-mutex": "^0.5.0",
    "bad-words": "^3.0.4",
    "bcryptjs": "^2.4.3",
    "bull": "^4.16.5",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "compression": "^1.7.4",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "expo-server-sdk": "^4.0.0",
    "express": "^4.21.1",
    "express-rate-limit": "^7.4.1",
    "fluent-ffmpeg": "^2.1.3",
    "get-video-duration": "^5.0.0",
    "helmet": "^8.0.0",
    "ioredis": "^5.3.2",
    "jsonwebtoken": "^9.0.2",
    "lucia": "^3.2.2",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "node-cron": "^4.2.1",
    "node-fetch": "^3.3.2",
    "oslo": "^1.2.1",
    "rate-limit-redis": "^4.3.1",
    "sharp": "^0.34.5",
    "socket.io": "^4.8.1",
    "svix": "^1.82.0",
    "uuid": "^11.0.3",
    "winston": "^3.17.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.7.5",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/morgan": "^1.9.9",
    "@types/multer": "^1.4.13",
    "@types/node": "^22.19.15",
    "@types/sharp": "^0.31.1",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "axios": "^1.14.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "fast-check": "^4.4.0",
    "jest": "^29.7.0",
    "nodemon": "^3.1.7",
    "prettier": "^3.4.2",
    "prisma": "^5.22.0",
    "ts-jest": "^29.1.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.2"
  }
}
