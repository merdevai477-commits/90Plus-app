{
  "expo": {
    "name": "90Plus",
    "slug": "90plus",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/90Plus.png",
    "scheme": "90plus",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.mrdev187.ninetyplusapp",
      "usesAppleSignIn": true,
      "infoPlist": {
        "UIBackgroundModes": [
          "remote-notification"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#4A148C",
        "foregroundImage": "./assets/images/90Plus.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/90Plus.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.mrdev187.ninetyplusapp",
      "permissions": [
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE",
        "SCHEDULE_EXACT_ALARM"
      ],
      "versionCode": 2
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/90Plus.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/90Plus.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#4A148C",
          "dark": {
            "backgroundColor": "#4A148C"
          }
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#22c55e"
        }
      ],
      "expo-video",
      "expo-web-browser",
      "expo-apple-authentication"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "jsEngine": "hermes",
    "optimization": {
      "images": {
        "allowUpscaling": false
      }
    },
    "extra": {
      "sportmonksToken": "mDAf5ClZwcEKXgFCkQoSpUtoumBDl4hT5FYzF8LtAYSNsZ0i19AdekwZQcSy",
      "apiUrl": "https://90plus-app-production.up.railway.app/api",
      "clerkPublishableKey": "pk_test_Z2xvd2luZy10aHJ1c2gtMTIuY2xlcmsuYWNjb3VudHMuZGV2JA",
      "router": {},
      "eas": {
        "projectId": "99512023-6916-4b26-be1e-8635ec3e0338"
      }
    },
    "owner": "mrdev187"
  }
}
