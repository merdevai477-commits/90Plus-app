{
  "expo": {
    "name": "90Plus",
    "slug": "90plus",
    "version": "1.0.1",
    "runtimeVersion": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/images/90Plus.png",
    "scheme": "ninetyplus",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": false,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.mhmdsh1892.ninetyplusapp",
      "usesAppleSignIn": true,
      "buildNumber": "2",
      "requireFullScreen": false,
      "infoPlist": {
        "UIBackgroundModes": [
          "remote-notification"
        ],
        "NSCameraUsageDescription": "This app uses camera to upload videos for reels",
        "NSMicrophoneUsageDescription": "This app uses microphone to record videos for reels",
        "NSPhotoLibraryUsageDescription": "This app uses photo library to select images and videos",
        "ITSAppUsesNonExemptEncryption": false,
        "UIRequiredDeviceCapabilities": [],
        "UIDeviceFamily": [1, 2]
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#4A148C",
        "foregroundImage": "./assets/images/90Plus.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/90Plus.png"
      },
      "package": "com.mhmdsh1892.ninetyplusapp",
      "permissions": [
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE",
        "SCHEDULE_EXACT_ALARM"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/90Plus.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/90Plus.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#4A148C",
          "dark": {
            "backgroundColor": "#4A148C"
          }
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/90Plus.png",
          "color": "#22c55e"
        }
      ],

      "expo-apple-authentication",
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "15.1"
          },
          "android": {
            "compileSdkVersion": 35,
            "targetSdkVersion": 35,
            "buildToolsVersion": "35.0.0",
            "minSdkVersion": 24
          }
        }
      ],
      "expo-font",
      "expo-localization",
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "jsEngine": "hermes",
