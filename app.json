{
  "expo": {
    "name": "90Plus",
    "slug": "90plus",
    "version": "1.0.1",
    "runtimeVersion": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/90Plus.png",
    "scheme": "ninetyplus",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.mhmdsh1892.ninetyplusapp",
      "usesAppleSignIn": true,
      "buildNumber": "2",
      "requireFullScreen": false,
      "infoPlist": {
        "UIBackgroundModes": [
          "remote-notification"
        ],
        "NSCameraUsageDescription": "90Plus needs access to your camera to capture photos and videos for your profile picture, cover image, and sharing football moments with the community.",
        "NSMicrophoneUsageDescription": "90Plus needs access to your microphone to record audio when creating video content for reels and sharing your football commentary.",
        "NSPhotoLibraryUsageDescription": "90Plus needs access to your photo library to select photos and videos for your profile, cover image, and sharing football content with other fans.",
        "NSPhotoLibraryAddUsageDescription": "90Plus needs permission to save photos and videos to your library so you can keep your favorite football moments.",
        "ITSAppUsesNonExemptEncryption": false,
        "UIRequiredDeviceCapabilities": [],
        "UIDeviceFamily": [
          1,
          2
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#4A148C",
        "foregroundImage": "./assets/images/90Plus.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/90Plus.png"
      },
      "package": "com.mhmdsh1892.ninetyplusapp",
      "permissions": [
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE",
        "SCHEDULE_EXACT_ALARM"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/90Plus.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/90Plus.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#4A148C",
          "dark": {
            "backgroundColor": "#4A148C"
          }
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/90Plus.png",
          "color": "#22c55e"
        }
      ],
      "expo-apple-authentication",
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "15.1",
            "useFrameworks": "static"
          },
          "android": {
            "compileSdkVersion": 35,
            "targetSdkVersion": 35,
            "buildToolsVersion": "35.0.0",
            "minSdkVersion": 24
          }
        }
      ],
      "expo-font",
      "expo-localization",
      "expo-secure-store",
      "@sentry/react-native/expo"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "jsEngine": "hermes",
    "updates": {
