{
  "name": "gemini-video-verification-poc",
  "version": "1.0.0",
  "private": true,
  "description": "Isolated POC: Gemini visual verification for football highlight frames (not production playback).",
  "type": "module",
  "scripts": {
    "discover": "node src/discoverModels.js",
    "connect": "node src/connectivityTest.js",
    "samples": "python scripts/generate_sample_assets.py",
    "extract": "python scripts/extract_frames.py",
    "analyze": "node src/runAnalyzer.js",
    "benchmark": "node src/benchmark.js",
    "report": "node src/generateReport.js",
    "poc": "node src/runFullPoc.js",
    "phase2:dataset": "node scripts/fetch_highlight_dataset.js",
    "phase2:run": "node phase2/run_phase2.js",
    "phase2:report": "node phase2/build_ground_truth_and_report.js",
    "phase3:prepare": "node phase3/prepare_dataset.js",
    "phase3:probe": "node phase3/run_player_path_probe.js",
    "phase3:report": "node phase3/build_report.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@google/genai": "^1.30.0",
    "dotenv": "^16.4.7"
  }
}
