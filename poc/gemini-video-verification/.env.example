# Isolated Gemini Video Verification POC
# Copy to .env in this folder OR rely on the repo-root .env (loaded automatically).
# Never commit real keys. Never put this key in React Native / frontend code.

GEMINI_API_KEY=your_gemini_api_key_here

# Optional overrides after model discovery / live probe
# GEMINI_VISION_MODEL=gemini-3.5-flash-lite
# GEMINI_POC_MAX_RETRIES=2
# Free-tier pacing (ms between benchmark requests). Observed ~15 RPM on flash-lite.
# GEMINI_POC_PACE_MS=5000
