generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                            String                   @id @default(uuid())
  clerkUserId                   String?                  @unique
  email                         String                   @unique
  username                      String                   @unique
  password                      String?
  displayName                   String?
  avatar                        String?
  avatarStoragePath             String?
  bio                           String?
  coins                         Int                      @default(0)
  level                         Int                      @default(1)
  xp                            Int                      @default(0)
  isVerified                    Boolean                  @default(false)
  isDeveloper                   Boolean                  @default(false)
  favoriteTeam                  String?
  favoriteBrand                 String?
  country                       String?
  favoriteLeagues               Int[]                    @default([])
  settings                      Json?                    @default("{}")
  position                      String?
  countryFlag                   String?
  location                      String?
  age                           Int?
  height                        Int?
  weight                        Int?
  preferredFoot                 String?
  clubLogo                      String?
  brandLogo                     String?
  socialLinks                   Json?                    @default("[]")
  lastUsernameChange            DateTime?
  lastAvatarChange              DateTime?
  lastCoverChange               DateTime?
  coverImage                    String?
  coverStoragePath              String?
  profileCompletionSteps        Json?                    @default("{}")
  profileCompletionPercentage   Int?                     @default(0)
  firstVideoUploaded            Boolean                  @default(false)
  storageUsedBytes              BigInt                   @default(0)
  storageQuotaBytes             BigInt                   @default(5368709120)
  profileViews                  Int                      @default(0)
  lastReelUpload                DateTime?
  /// منع رفعات متزامنة: يُضبط عند بدء الرفع ويُمسح عند النجاح/الفشل (انتهاء تلقائي بعد المدة)
  reelUploadLockedUntil         DateTime?
  reelDeleteCount               Int                      @default(0)
  lastDailySpin                 DateTime?
  lastLoginDate                 DateTime?
  consecutiveLoginDays          Int                      @default(0)
  expoPushToken                 String?
  /// Multi-device Expo push tokens (Android + iOS can both stay registered).
  pushDevices                   UserPushDevice[]
  emailVerified                 Boolean                  @default(false)
  emailVerificationToken        String?                  @unique
  emailVerificationTokenExpires DateTime?
  isSuspended                   Boolean                  @default(false)
  suspendedUntil                DateTime?
  isBanned                      Boolean                  @default(false)
  bannedAt                      DateTime?
  banReason                     String?
  warningsCount                 Int                      @default(0)
  role                          UserRole                 @default(USER)
  isDeleted                     Boolean                  @default(false)
  deletedAt                     DateTime?
  scheduledDeletionAt           DateTime?
  deletionRequestedAt           DateTime?
  analyticsConsent              Boolean                  @default(true)
  pushNotificationsConsent      Boolean                  @default(false)
  emailCommunicationsConsent    Boolean                  @default(true)
  dataSharingConsent            Boolean                  @default(false)
  privacyPolicyVersion          String?
  privacyPolicyAcceptedAt       DateTime?
  createdAt                     DateTime                 @default(now())
  updatedAt                     DateTime                 @updatedAt
  lastActiveAt                  DateTime?
  streakFreezes                 Int                      @default(0)
  groupExitCount                Int                      @default(0)
  groupBannedUntil              DateTime?
  dateOfBirth                   DateTime?
  ageVerifiedAt                 DateTime?
  ageTier                       AgeTier?
  parentalConsent               Boolean                  @default(false)
  parentEmail                   String?
  parentalConsentRequestedAt    DateTime?
  parentalConsentConfirmedAt    DateTime?
  accountDeletionRequests       AccountDeletionRequest[] @relation("UserAccountDeletions")
  bannedWordsCreated            BannedWord[]             @relation("BannedWordCreator")
  blockedByUsers                Block[]                  @relation("UserBlocked")
  blockedUsers                  Block[]                  @relation("UserBlocking")
  coinTransactions              CoinTransaction[]
  commentLikes                  CommentLike[]
  commentMentions               CommentMention[]         @relation("CommentMentions")
  comments                      Comment[]
  consentLogs                   ConsentLog[]             @relation("UserConsentLogs")
  dailySpins                    DailySpinHistory[]
  dataExportRequests            DataExportRequest[]      @relation("UserDataExports")
  favoriteMatches               FavoriteMatch[]
  followers                     Follow[]                 @relation("UserFollowers")
  following                     Follow[]                 @relation("UserFollowing")
  gdprAuditLogs                 GDPRAuditLog[]           @relation("UserGDPRAuditLogs")
  likes                         Like[]
  loginStreak                   LoginStreak?             @relation("UserLoginStreak")
  moderationReviews             ModerationLog[]          @relation("ModerationLogReviewer")
  moderationLogs                ModerationLog[]          @relation("ModerationLogUser")
  notificationPreferences       NotificationPreferences?
  notifications                 Notification[]
  parentalConsentRequests       ParentalConsentRequest[]
  predictions                   Prediction[]
  ownedPredictionGroups         PredictionGroup[]        @relation("OwnedPredictionGroups")
  groupMemberships              GroupMember[]
  groupInvitesSent              GroupInvite[]            @relation("GroupInvitesSent")
  groupInvitesReceived          GroupInvite[]            @relation("GroupInvitesReceived")
  groupPredictions              GroupPrediction[]
  quizAttempts                  QuizAttempt[]
  reelShares                    ReelShare[]
  reelViews                     ReelView[]
  reels                         Reel[]
  refreshTokens                 RefreshToken[]
  reportsReceived               Report[]                 @relation("ReportedUser")
  reportsCreated                Report[]                 @relation("ReportCreator")
  reportsReviewed               Report[]                 @relation("ReportReviewer")
  savedReels                    SavedReel[]
  sessions                      Session[]
  strikes                       Strike[]
  termsAcceptances              TermsAcceptance[]
  achievements                  UserAchievement[]
  bansIssued                    UserBan[]                @relation("BanIssuer")
  bans                          UserBan?                 @relation("UserBans")
  dailyQuizSessions             UserDailyQuizSession[]
  quizAnswers                   UserQuizAnswer[]
  quizState                     UserQuizState?
  warningsIssued                UserWarning[]            @relation("WarningIssuer")
  warnings                      UserWarning[]            @relation("UserWarnings")
  xpDailyCaps                   XpDailyCap[]             @relation("UserXpDailyCaps")
  xpTransactions                XpTransaction[]          @relation("UserXpTransactions")

  @@index([email])
  @@index([username])
  @@index([level])
  @@index([xp(sort: Desc)])
  @@index([coins])
  @@index([createdAt])
  @@index([isDeleted])
  @@index([scheduledDeletionAt])
  @@index([ageVerifiedAt])
  @@index([ageTier])
  @@index([parentalConsent])
  @@index([xp(sort: Desc), level(sort: Desc)])
  @@map("users")
}

/// One Expo push token per physical device. Keeps Android + iOS registered together
/// (User.expoPushToken alone was overwritten when switching phones).
model UserPushDevice {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  platform  String   @default("unknown")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([platform])
  @@map("user_push_devices")
}

model ParentalConsentRequest {
  id          String        @id @default(uuid())
  userId      String
  parentEmail String
  token       String        @unique
  status      ConsentStatus @default(PENDING)
  requestedAt DateTime      @default(now())
  confirmedAt DateTime?
  expiresAt   DateTime
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@index([status])
  @@index([expiresAt])
  @@index([parentEmail])
  @@map("parental_consent_requests")
}

model RefreshToken {
  id         String    @id @default(uuid())
  userId     String
  token      String    @unique
  deviceInfo String?
  ipAddress  String?
  userAgent  String?
  isRevoked  Boolean   @default(false)
  expiresAt  DateTime
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model Session {
  id        String   @id
  userId    String
  expiresAt DateTime
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model League {
  id        String   @id @default(uuid())
  name      String
  country   String
  logo      String?
  season    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  matches   Match[]
  teams     Team[]

  @@index([country])
  @@index([season])
  @@map("leagues")
}

model Team {
  id          String   @id @default(uuid())
  name        String
  logo        String?
  country     String
  stadium     String?
  founded     Int?
  leagueId    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  awayMatches Match[]  @relation("AwayTeam")
  homeMatches Match[]  @relation("HomeTeam")
  players     Player[]
  league      League?  @relation(fields: [leagueId], references: [id])

  @@index([leagueId])
  @@index([country])
  @@index([name])
  @@map("teams")
}

model Player {
  id          String       @id @default(uuid())
  name        String
  photo       String?
  position    String
  number      Int?
  nationality String
  age         Int?
  teamId      String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  stats       PlayerStats?
  team        Team?        @relation(fields: [teamId], references: [id])

  @@index([teamId])
  @@index([position])
  @@index([nationality])
  @@index([name])
  @@map("players")
}

model PlayerStats {
  id        String @id @default(uuid())
  playerId  String @unique
  pace      Int
  shooting  Int
  passing   Int
  dribbling Int
  defending Int
  physical  Int
  overall   Int
  player    Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@index([overall])
  @@map("player_stats")
}

model Match {
  id         String      @id @default(uuid())
  homeTeamId String
  awayTeamId String
  homeScore  Int?
  awayScore  Int?
  status     MatchStatus
  leagueId   String
  matchDate  DateTime
  venue      String?
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  awayTeam   Team        @relation("AwayTeam", fields: [awayTeamId], references: [id])
  homeTeam   Team        @relation("HomeTeam", fields: [homeTeamId], references: [id])
  league     League      @relation(fields: [leagueId], references: [id])

  @@index([status])
  @@index([matchDate])
  @@index([leagueId])
  @@index([homeTeamId])
  @@index([awayTeamId])
  @@map("matches")
}

model QuizCategory {
  id           String         @id @default(uuid())
  name         String         @unique
  icon         String?
  description  String?
  isLocked     Boolean        @default(false)
  unlockLevel  Int            @default(1)
  createdAt    DateTime       @default(now())
  dailyQuizzes DailyQuiz[]
  attempts     QuizAttempt[]
  questions    QuizQuestion[]

  @@index([isLocked])
  @@map("quiz_categories")
}

model QuizQuestion {
  id            String           @id @default(uuid())
  categoryId    String
  question      String
  options       String[]
  correctAnswer String
  difficulty    Difficulty
  points        Int              @default(10)
  imageUrl      String?
  imageType     String?
  hint          String?
  timeLimit     Int              @default(15)
  displayMode   DisplayMode      @default(NEVER)
  createdAt     DateTime         @default(now())
  category      QuizCategory     @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  answers       UserQuizAnswer[]

  @@index([categoryId])
  @@index([difficulty])
  @@map("quiz_questions")
}

model QuizAttempt {
  id             String           @id @default(uuid())
  userId         String
  categoryId     String
  score          Int
  totalQuestions Int
  correctAnswers Int
  coinsEarned    Int
  xpEarned       Int              @default(0)
  streak         Int              @default(0)
  bestStreak     Int              @default(0)
  timeTaken      Int
  completedAt    DateTime         @default(now())
  canRetryAt     DateTime
  category       QuizCategory     @relation(fields: [categoryId], references: [id])
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  answers        UserQuizAnswer[]

  @@index([userId])
  @@index([categoryId])
  @@index([completedAt])
  @@index([score])
  @@index([canRetryAt])
  @@map("quiz_attempts")
}

model UserQuizAnswer {
  id         String       @id @default(uuid())
  userId     String
  questionId String
  attemptId  String
  userAnswer String
  isCorrect  Boolean
  timeTaken  Int
  createdAt  DateTime     @default(now())
  attempt    QuizAttempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question   QuizQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([questionId])
  @@index([attemptId])
  @@map("user_quiz_answers")
}

model UserQuizState {
  id                    String    @id @default(uuid())
  userId                String    @unique
  currentOpenCategoryId String?
  lastCategoryOpenedAt  DateTime?
  nextCategoryUnlockAt  DateTime?
  completedCategoryIds  String[]  @default([])
  lastAttemptAt         DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([currentOpenCategoryId])
  @@index([nextCategoryUnlockAt])
  @@map("user_quiz_states")
}

model DailyQuiz {
  id          String       @id @default(uuid())
  categoryId  String
  questionIds String[]
  date        DateTime     @unique @db.Date
  expiresAt   DateTime
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  category    QuizCategory @relation(fields: [categoryId], references: [id])

  @@index([date])
  @@index([categoryId])
  @@index([expiresAt])
  @@map("daily_quizzes")
}

/// AI-generated daily question packs (20 per language, renewed every 24h)
model DailyQuizPack {
  id               String   @id @default(uuid())
  packDate         DateTime @db.Date
  language         String   @db.VarChar(5)
  questions        Json
  expiresAt        DateTime
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  isFallback       Boolean  @default(false)
  generatorModel   String?  @db.VarChar(64)
  generatorVersion String?  @db.VarChar(32)
  promptVersion    String?  @db.VarChar(32)
  datasetVersion   String?  @db.VarChar(32)

  @@unique([packDate, language])
  @@index([packDate])
  @@index([expiresAt])
  @@index([isFallback])
  @@map("daily_quiz_packs")
}

/// Aggregated engagement metrics per daily quiz question (cross-user).
model QuizQuestionMetric {
  id                String   @id @default(uuid())
  questionId        String
  packDate          DateTime @db.Date
  language          String   @db.VarChar(5)
  questionType      String?  @db.VarChar(20)
  difficulty        String?  @db.VarChar(10)
  shownCount        Int      @default(0)
  correctCount      Int      @default(0)
  wrongCount        Int      @default(0)
  skipCount         Int      @default(0)
  hintCount         Int      @default(0)
  totalAnswerTimeMs BigInt   @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([questionId, packDate, language])
  @@index([packDate, language])
  @@index([questionType])
  @@index([difficulty])
  @@index([correctCount])
  @@index([skipCount])
  @@map("quiz_question_metrics")
}

/// Per-user progress for a daily pack (answers, skips, hints, XP)
model UserDailyQuizSession {
  id            String    @id @default(uuid())
  userId        String
  packDate      DateTime  @db.Date
  language      String    @db.VarChar(5)
  progress      Json      @default("{}")
  correctCount  Int       @default(0)
  answeredCount Int       @default(0)
  skippedCount  Int       @default(0)
  xpEarned      Int       @default(0)
  completedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, packDate, language])
  @@index([userId])
  @@index([packDate])
  @@map("user_daily_quiz_sessions")
}

model CoinTransaction {
  id          String              @id @default(uuid())
  userId      String
  amount      Int
  type        CoinTransactionType
  description String?
  createdAt   DateTime            @default(now())
  user        User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
  @@index([type])
  @@map("coin_transactions")
}

model Achievement {
  id               String              @id @default(uuid())
  name             String              @unique
  description      String
  icon             String?
  category         AchievementCategory
  requirement      Json
  coinReward       Int                 @default(0)
  xpReward         Int                 @default(0)
  rarity           AchievementRarity
  createdAt        DateTime            @default(now())
  userAchievements UserAchievement[]

  @@index([category])
  @@index([rarity])
  @@map("achievements")
}

model UserAchievement {
  id            String      @id @default(uuid())
  userId        String
  achievementId String
  progress      Int         @default(0)
  isCompleted   Boolean     @default(false)
  completedAt   DateTime?
  createdAt     DateTime    @default(now())
  achievement   Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, achievementId])
  @@index([userId])
  @@index([achievementId])
  @@index([isCompleted])
  @@map("user_achievements")
}

model Follow {
  id          String   @id @default(uuid())
  followerId  String
  followingId String
  createdAt   DateTime @default(now())
  follower    User     @relation("UserFollowers", fields: [followerId], references: [id], onDelete: Cascade)
  following   User     @relation("UserFollowing", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@index([followerId])
  @@index([followingId])
  @@index([createdAt])
  @@index([followingId, createdAt])
  @@map("follows")
}

model Block {
  id        String   @id @default(uuid())
  blockerId String
  blockedId String
  createdAt DateTime @default(now())
  blocked   User     @relation("UserBlocked", fields: [blockedId], references: [id], onDelete: Cascade)
  blocker   User     @relation("UserBlocking", fields: [blockerId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
  @@index([blockerId])
  @@index([blockedId])
  @@map("blocks")
}

model Reel {
  id                   String        @id @default(uuid())
  userId               String
  videoUrl             String
  videoStoragePath     String?
  processedVideoUrl    String?
  processedVideoKey    String?
  thumbnail            String?
  thumbnailStoragePath String?
  caption              String?
  views                Int           @default(0)
  sharesCount          Int           @default(0)
  fileSizeBytes        BigInt        @default(0)
  status               ReelStatus    @default(PROCESSING)
  muxUploadId          String?
  muxAssetId           String?
  muxPlaybackId        String?
  isDeleted            Boolean       @default(false)
  deletedAt            DateTime?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
  publishedAt          DateTime?
  comments             Comment[]
  likes                Like[]
  hashtags             ReelHashtag[]
  mentions             ReelMention[]
  shares               ReelShare[]
  reelViews            ReelView[]
  user                 User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  reports              Report[]
  savedBy              SavedReel[]
  strikes              Strike[]

  @@index([publishedAt])
  @@index([userId])
  @@index([views])
  @@index([createdAt])
  @@index([sharesCount])
  @@index([createdAt, views])
  @@index([createdAt, sharesCount])
  @@index([isDeleted])
  @@map("reels")
}

model Hashtag {
  id        String        @id @default(uuid())
  name      String        @unique
  reelCount Int           @default(0)
  createdAt DateTime      @default(now())
  reels     ReelHashtag[]

  @@index([name])
  @@index([reelCount])
  @@map("hashtags")
}

model ReelHashtag {
  id        String   @id @default(uuid())
  reelId    String
  hashtagId String
  createdAt DateTime @default(now())
  hashtag   Hashtag  @relation(fields: [hashtagId], references: [id], onDelete: Cascade)
  reel      Reel     @relation(fields: [reelId], references: [id], onDelete: Cascade)

  @@unique([reelId, hashtagId])
  @@index([reelId])
  @@index([hashtagId])
  @@map("reel_hashtags")
}

model ReelMention {
  id              String   @id @default(uuid())
  reelId          String
  mentionedUserId String
  createdAt       DateTime @default(now())
  reel            Reel     @relation(fields: [reelId], references: [id], onDelete: Cascade)

  @@unique([reelId, mentionedUserId])
  @@index([reelId])
  @@index([mentionedUserId])
  @@map("reel_mentions")
}

model Like {
  id        String   @id @default(uuid())
  userId    String
  reelId    String
  createdAt DateTime @default(now())
  reel      Reel     @relation(fields: [reelId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, reelId])
  @@index([userId])
  @@index([reelId])
  @@index([createdAt])
  @@map("likes")
}

model ReelView {
  id       String   @id @default(uuid())
  reelId   String
  userId   String
  viewedAt DateTime @default(now())
  reel     Reel     @relation(fields: [reelId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([reelId, userId])
  @@index([reelId])
  @@index([userId])
  @@index([viewedAt])
  @@map("reel_views")
}

model Comment {
  id        String           @id @default(uuid())
  userId    String
  reelId    String
  parentId  String?
  content   String
  isDeleted Boolean          @default(false)
  deletedAt DateTime?
  createdAt DateTime         @default(now())
  likes     CommentLike[]
  mentions  CommentMention[]
  parent    Comment?         @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies   Comment[]        @relation("CommentReplies")
  reel      Reel             @relation(fields: [reelId], references: [id], onDelete: Cascade)
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  reports   Report[]
  strikes   Strike[]

  @@index([userId])
  @@index([reelId])
  @@index([parentId])
  @@index([createdAt])
  @@index([isDeleted])
  @@map("comments")
}

model CommentMention {
  id              String   @id @default(uuid())
  commentId       String
  mentionedUserId String
  createdAt       DateTime @default(now())
  comment         Comment  @relation(fields: [commentId], references: [id], onDelete: Cascade)
  mentionedUser   User     @relation("CommentMentions", fields: [mentionedUserId], references: [id], onDelete: Cascade)

  @@unique([commentId, mentionedUserId])
  @@index([commentId])
  @@index([mentionedUserId])
  @@map("comment_mentions")
}

model CommentLike {
  id        String   @id @default(uuid())
  userId    String
  commentId String
  createdAt DateTime @default(now())
  comment   Comment  @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, commentId])
  @@index([userId])
  @@index([commentId])
  @@map("comment_likes")
}

model SavedReel {
  id        String   @id @default(uuid())
  userId    String
  reelId    String
  createdAt DateTime @default(now())
  reel      Reel     @relation(fields: [reelId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, reelId])
  @@index([userId])
  @@index([reelId])
  @@index([createdAt])
  @@map("saved_reels")
}

model ReelShare {
  id        String   @id @default(uuid())
  userId    String
  reelId    String
  platform  String?
  createdAt DateTime @default(now())
  reel      Reel     @relation(fields: [reelId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([reelId])
  @@index([createdAt])
  @@map("reel_shares")
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  title     String
