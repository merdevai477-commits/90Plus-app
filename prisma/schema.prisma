  @@index([playerName])
  @@index([expiresAt])
  @@map("player_stats_cache")
}

model PlayerNameMapping {
  id             String   @id @default(uuid())
  arabicName     String
  englishName    String
  aliases        String[]
  apiPlayerId    Int      @unique
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  /// Diacritic-stripped, lowercased key used for accent-insensitive matching.
  normalizedName String   @default("")

  @@index([arabicName])
  @@index([englishName])
  @@index([normalizedName])
  @@map("player_name_mapping")
}

model PlayerInfo {
  id              String    @id @default(uuid())
  playerName      String
  displayName     String?
  apiPlayerId     Int?
  queryType       String
  language        String
  questionSample  String
  answer          String
  apiFingerprint  String
  apiContext      String
  usedModel       String?
  answeredOn      DateTime  @default(now())
  refreshedAt     DateTime  @default(now())
  expiresAt       DateTime
  hits            Int       @default(0)
  teamId          Int?
  lastRefreshType String?
  refreshPriority Int       @default(1)
  accessCount     Int       @default(0)
  teamInfo        TeamInfo? @relation(fields: [teamId], references: [id])

  @@unique([playerName, queryType, language])
  @@index([playerName])
  @@index([answeredOn])
  @@index([expiresAt])
  @@index([teamId])
  @@index([lastRefreshType])
  @@index([apiPlayerId])
  @@map("player_info")
}

model TeamInfo {
  id          Int          @id @default(autoincrement())
  apiTeamId   Int          @unique
  teamName    String
  season      Int
  lastFetched DateTime
  expiresAt   DateTime
  playerInfos PlayerInfo[]
  players     TeamPlayer[]

  @@index([expiresAt])
  @@map("team_info")
}

model TeamPlayer {
  id           Int      @id @default(autoincrement())
  teamInfoId   Int
  apiPlayerId  Int
  playerName   String
  position     String
  jerseyNumber Int?
  teamInfo     TeamInfo @relation(fields: [teamInfoId], references: [id], onDelete: Cascade)

  @@index([teamInfoId])
  @@index([apiPlayerId])
  @@map("team_player")
}

model RefreshControl {
  id        Int      @id @default(autoincrement())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt

  @@map("refresh_control")
}

model XpTransaction {
  id             String       @id @default(uuid())
  userId         String
  action         XpActionType
  amount         Int
  idempotencyKey String?
  metadata       Json?
  createdAt      DateTime     @default(now())
  user           User         @relation("UserXpTransactions", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, idempotencyKey])
  @@index([userId, createdAt])
  @@index([action])
  @@map("xp_transactions")
}

model XpDailyCap {
  id     String       @id @default(uuid())
  userId String
  action XpActionType
  date   String
  count  Int          @default(0)
  user   User         @relation("UserXpDailyCaps", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, action, date])
  @@index([userId, date])
  @@map("xp_daily_caps")
}

model LoginStreak {
  id            String  @id @default(uuid())
  userId        String  @unique
  current       Int     @default(0)
  longest       Int     @default(0)
  lastLoginDate String?
  user          User    @relation("UserLoginStreak", fields: [userId], references: [id], onDelete: Cascade)

  @@map("login_streaks")
}

