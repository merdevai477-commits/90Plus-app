model FavoriteMatch {
  id                    String               @id @default(uuid())
  userId                String
  apiMatchId            Int
  homeTeam              String
  awayTeam              String
  homeTeamLogo          String?
  awayTeamLogo          String?
  matchDate             DateTime
  leagueName            String?
  lastHomeScore         Int?
  lastAwayScore         Int?
  lastStatus            String?
  notifiedStart         Boolean              @default(false)
  notifiedEnd           Boolean              @default(false)
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
  /// Anchor for subscription-aware delivery — updated on every subscribe/re-subscribe
  subscribedAt          DateTime             @default(now())
  /// Cursor into the canonical match event stream (last delivered eventKey)
  lastDeliveredEventKey String?
  /// Score/status snapshot at subscribe time (guards retroactive goal alerts)
  baselineHomeScore     Int?
  baselineAwayScore     Int?
  baselineStatus        String?
  user                  User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  deliveries            MatchEventDelivery[]

  @@unique([userId, apiMatchId])
  @@index([userId])
  @@index([apiMatchId])
  @@index([matchDate])
  @@index([notifiedEnd, matchDate])
  @@index([apiMatchId, subscribedAt])
  @@map("favorite_matches")
}

/// Canonical match events — one row per distinct event per fixture (shared by all subscribers)
model MatchEvent {
  id          String               @id @default(uuid())
  fixtureId   Int
  eventKey    String
  eventType   String
  minute      Int?
  extraMinute Int?
  teamId      Int?
  playerId    Int?
  payload     Json
  detectedAt  DateTime             @default(now())
  deliveries  MatchEventDelivery[]

  @@unique([fixtureId, eventKey])
  @@index([fixtureId, detectedAt])
  @@map("match_events")
}

/// Per-subscription delivery ledger — prevents duplicate pushes at scale
model MatchEventDelivery {
  id             String        @id @default(uuid())
  subscriptionId String
  eventKey       String
  deliveredAt    DateTime      @default(now())
  fixtureId      Int
  event          MatchEvent    @relation(fields: [fixtureId, eventKey], references: [fixtureId, eventKey], onDelete: Cascade)
  subscription   FavoriteMatch @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@unique([subscriptionId, eventKey])
  @@index([subscriptionId])
  @@map("match_event_deliveries")
}

