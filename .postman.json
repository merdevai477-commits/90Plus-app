      {
        "name": "Daily Spin",
        "item": [
          {
            "name": "Get Spin Status",
            "request": {
              "method": "GET",
              "header": [],
              "url": {
                "raw": "{{base_url}}/daily-spin/status",
                "host": ["{{base_url}}"],
                "path": ["daily-spin", "status"]
              },
              "description": "Check if user can spin today and get spin history"
            },
            "response": [],
            "event": [
              {
                "listen": "test",
                "script": {
                  "exec": [
                    "pm.test(\"Status code is 200\", function () {",
                    "    pm.response.to.have.status(200);",
                    "});",
                    "",
                    "pm.test(\"Response has SUCCESS status\", function () {",
                    "    var jsonData = pm.response.json();",
                    "    pm.expect(jsonData.status).to.eql(\"SUCCESS\");",
                    "});",
                    "",
                    "pm.test(\"Response contains spin data\", function () {",
                    "    var jsonData = pm.response.json();",
                    "    pm.expect(jsonData.data).to.have.property(\"canSpin\");",
                    "    pm.expect(jsonData.data).to.have.property(\"currentCoins\");",
                    "    pm.expect(jsonData.data).to.have.property(\"prizes\");",
                    "});"
                  ],
                  "type": "text/javascript"
                }
              }
            ]
          },
          {
            "name": "Spin Wheel",
            "request": {
              "method": "POST",
              "header": [],
              "url": {
                "raw": "{{base_url}}/daily-spin/spin",
                "host": ["{{base_url}}"],
                "path": ["daily-spin", "spin"]
              },
              "description": "Spin the daily wheel and get prize"
            },
            "response": [],
            "event": [
              {
                "listen": "test",
                "script": {
                  "exec": [
                    "pm.test(\"Status code is 200 or 429\", function () {",
                    "    pm.expect(pm.response.code).to.be.oneOf([200, 429]);",
                    "});",
                    "",
                    "if (pm.response.code === 200) {",
                    "    pm.test(\"Response has SUCCESS status\", function () {",
                    "        var jsonData = pm.response.json();",
                    "        pm.expect(jsonData.status).to.eql(\"SUCCESS\");",
                    "    });",
                    "    ",
                    "    pm.test(\"Response contains prize data\", function () {",
                    "        var jsonData = pm.response.json();",
                    "        pm.expect(jsonData.data).to.have.property(\"prize\");",
                    "        pm.expect(jsonData.data).to.have.property(\"newBalance\");",
                    "    });",
                    "} else if (pm.response.code === 429) {",
                    "    pm.test(\"Cooldown error returned\", function () {",
                    "        var jsonData = pm.response.json();",
                    "        pm.expect(jsonData.code).to.eql(\"SPIN_COOLDOWN\");",
                    "    });",
                    "}"
                  ],
                  "type": "text/javascript"
                }
              }
            ]
          },
