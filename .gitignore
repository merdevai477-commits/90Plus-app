# Dependencies
node_modules/
*/node_modules/

# Environment
.env
*.env.local

# Build
dist/
build/

# Expo
.expo/

# IDE
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db

# Kiro settings (contains API keys)
.kiro/settings/

# Test result files (use CI/CD logs instead)
test-results*.txt
*-test-results.txt

# Commit message artifacts
COMMIT_MESSAGE*.txt

# Temporary / debug scripts — keep scripts in scripts/ folder
/test-*.ts
/check-*.ts
/create-*.ts
/clear-*.ts
/apply-*.ts
/quick-*.ts
/quick-*.js
/fix-*.sh
/deploy-*.sh

# Prisma build cache
.tsbuildinfo

# Chat data (per-instance JSON store)
data/chat/

# Large binary assets — commit these through Git LFS or upload to CDN instead
_tmp_*.png
front/assets/images/*.png
# Keep only essential small icons (override above by un-ignoring)
!front/assets/images/icon.png
!front/assets/images/favicon.png
!front/assets/images/splash-icon.png
!front/assets/images/android-icon-background.png
!front/assets/images/android-icon-foreground.png
!front/assets/images/android-icon-monochrome.png
