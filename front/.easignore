# Dependencies — EAS installs these on the server
node_modules/

# Git
.git/

# Expo cache
.expo/
.expo-shared/
.expo-tmp-export/
.expo-tmp-export-check/
.metro-cache/

# Build outputs
dist/
build/
*.log
.eas-log.txt
tsconfig.tsbuildinfo
.tmp-expo-config.json

# Native folders — regenerated by EAS via prebuild on every build (CNG)
# Keeping these out ensures app.json / plugin changes always take effect cleanly.
ios/
android/
# Never upload machine-local Node path overrides (breaks EAS with wrong NODE_BINARY / CRLF)
ios/.xcode.env.local

# IDE & OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Tests
__tests__/
*.test.ts
*.test.tsx
*.test.js
*.spec.ts
*.spec.tsx
*.spec.js
coverage/

# Env files (secrets managed via EAS env vars)
.env.local
.env.*.local
.env.development
.env.test

# Misc
*.orig
.cache/
*.md

# EAS also respects root .gitignore when packing the upload. PNGs under
# assets/images are ignored globally except an allowlist there — keep
# arena_profile.png available in the archive for Metro on the builder.
!assets/images/arena_profile.png
