# NOT USED BY EAS CLI.
# EAS packs from the git repo root and reads only /.easignore
# (see https://expo.fyi/eas-build-archive). Keep this file as a local
# reminder of what must stay out of the upload; edit the ROOT .easignore
# to actually change archive size.

# Dependencies — EAS runs npm install on the builder
node_modules/

# Git / Expo caches
.git/
.expo/
.expo-shared/
.expo-tmp-export/
.expo-tmp-export-check/
.metro-cache/

# Web export + native trees
dist/
build/
android/
ios/

# Build artifacts
*.log
.eas-log.txt
tsconfig.tsbuildinfo
.tmp-expo-config.json
.env
.env.production
*.jks
@*.jks
