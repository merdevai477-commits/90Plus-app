# EAS uses .easignore INSTEAD of .gitignore when this file exists.
# Keep this list complete — a missing rule re-uploads android/dist/node_modules.

# Dependencies — EAS runs npm install on the builder
node_modules/
/node_modules
/node_modules/**

# Git / Expo caches
.git/
.expo/
.expo-shared/
.expo-tmp-export/
.expo-tmp-export-check/
.metro-cache/

# Web export + native trees. `dist/` is a local `expo export` (~128 MB) and
# was the main reason the upload tarball hit ~122 MB. android/ is a local
# prebuild (~2 GB) and must never ship. EAS regenerates native via prebuild.
dist/
dist/**
/dist
/dist/**
build/
android/
android/**
/android
/android/**
ios/
ios/**
/ios
/ios/**
ios/.xcode.env.local

# Build artifacts
*.log
.eas-log.txt
tsconfig.tsbuildinfo
.tmp-expo-config.json

# IDE & OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Tests
__tests__/
*.test.ts
*.test.tsx
*.test.js
*.spec.ts
*.spec.tsx
*.spec.js
coverage/

# Env
.env.local
.env.*.local
.env.development
.env.test

# Misc
*.orig
.cache/
*.md
*.ps1
*.sh
scripts/_compress_eas_assets.py
scripts/_tmp_*

# Unused design dumps — not required() by any screen
assets/Quiz/
assets/images/*.original.png
assets/images/around-card.png
assets/images/around-card.original.png
