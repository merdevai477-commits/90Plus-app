    "react-test-renderer": "^18.3.1",
    "tailwindcss": "^3.4.0",
    "ts-jest": "^29.1.2",
    "typescript": "~5.9.2"
  },
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "expo-av",
          "@clerk/clerk-expo",
          "@radix-ui/react-dialog",
          "ajv",
          "ajv-keywords",
          "nanoid",
          "react-native-vector-icons",
          "socket.io-client",
          "uuid"
        ],
        "listUnknownPackages": false
      }
    },
    "install": {
      "exclude": [
        "@sentry/react-native"
      ]
    }
  },
  "private": true
