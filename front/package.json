  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "@clerk/clerk-expo",
          "@radix-ui/react-dialog",
          "ajv",
          "ajv-keywords",
          "nanoid",
          "react-native-vector-icons",
          "socket.io-client",
          "uuid"
