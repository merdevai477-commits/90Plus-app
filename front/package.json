    "expo-status-bar": "~2.0.1",
    "expo-symbols": "~0.2.2",
    "expo-system-ui": "~4.0.9",
    "expo-updates": "~0.27.5",
    "expo-video-thumbnails": "~9.0.3",
    "expo-web-browser": "~14.0.2",
    "lottie-react-native": "7.1.0",
    "lucide-react-native": "^0.475.0",
    "nanoid": "^5.1.6",
    "react": "18.3.1",
    "react-dom": "18.3.1",
