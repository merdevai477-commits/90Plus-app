{
  "name": "90plus",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start --lan",
    "start:offline": "expo start --offline",
    "start:online": "expo start --lan",
    "start:tunnel": "expo start --tunnel",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "build:android": "eas build --platform android --profile production",
    "build:ios": "eas build --platform ios --profile production",
    "build:prod": "NODE_ENV=production eas build --profile production",
    "lint": "expo lint",
    "lint:fix": "eslint --fix .",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "check:console": "node scripts/check-console-logs.js",
    "check:types": "tsc --noEmit",
    "check:all": "npm run check:console && npm run check:types && npm run lint && npm test",
    "postinstall": "patch-package"
  },
  "dependencies": {
    "@callstack/liquid-glass": "^0.7.1",
    "@clerk/clerk-expo": "^2.18.0",
    "@expo-google-fonts/cairo": "^0.4.2",
