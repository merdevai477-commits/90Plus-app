    "@tamagui/core": "^2.0.0-rc.41",
    "@tanstack/react-query": "^5.62.0",
    "ajv": "^8.18.0",
    "axios": "^1.14.0",
    "expo": "~52.0.0",
    "expo-apple-authentication": "~7.1.3",
    "expo-application": "~6.0.2",
    "expo-auth-session": "~6.0.3",
    "expo-av": "~15.0.2",
    "expo-blur": "~14.0.3",
