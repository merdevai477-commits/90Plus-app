# 🔐 Environment Variables Template
# Copy this file to .env and fill in your actual values
# NEVER commit .env to version control!

# ============================================
# API Configuration
# ============================================
EXPO_PUBLIC_API_URL=https://90plus.pro/api
EXPO_PUBLIC_WS_URL=wss://90plus.pro
# Share links (reels, profiles, app invite) — backend root, not /api
EXPO_PUBLIC_SHARE_BASE_URL=https://90plus.pro

# Quiz preview: API-Football v3 via Railway (FOOTBALL_API_KEY on server — see root .env)
EXPO_PUBLIC_QUIZ_USE_MATCHES_API=true

# TEMP dev only — direct api-sports from app (remove before production)
# EXPO_PUBLIC_QUIZ_USE_DIRECT_FOOTBALL_API=true
# EXPO_PUBLIC_FOOTBALL_API_KEY=your_api_football_key
# EXPO_PUBLIC_FOOTBALL_API_BASE=https://v3.football.api-sports.io

# ============================================
# Authentication (Clerk)
# ============================================
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_key_here

# ============================================
# Sports Data API (optional — other screens)
# Quiz uses Railway /api/football (API-Football v3 + FOOTBALL_API_KEY on backend)
# ============================================
EXPO_PUBLIC_SPORTMONKS_TOKEN=your_sportmonks_token_here

# ============================================
# Development (Optional)
# ============================================
# For local development with ngrok
EXPO_PUBLIC_NGROK_URL=

# For local development with IP
EXPO_PUBLIC_LOCAL_IP=192.168.1.7

# ============================================
# Analytics & Monitoring (Optional)
# ============================================
# Sentry DSN for error tracking
# EAS: SENTRY_DISABLE_AUTO_UPLOAD is set in eas.json unless you add SENTRY_AUTH_TOKEN in EAS secrets.
EXPO_PUBLIC_SENTRY_DSN=

# Firebase/Analytics keys
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Push forensic trace logs in Metro (__DEV__ enables automatically)
# EXPO_PUBLIC_PUSH_TRACE=1

# ============================================
# Feature Flags (Optional)
# ============================================
EXPO_PUBLIC_ENABLE_ANALYTICS=false
EXPO_PUBLIC_ENABLE_ERROR_TRACKING=false
EXPO_PUBLIC_ENABLE_DEBUG_LOGS=false
