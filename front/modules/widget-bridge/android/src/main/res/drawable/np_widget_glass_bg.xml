<?xml version="1.0" encoding="utf-8"?>
<!-- Figma 1442:4283: rgba(20,17,28) card with inset purple glow. Launchers cannot blur the
     wallpaper behind a widget, so the "glass" is a translucent fill, sheen and rim instead. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
  <item>
    <shape android:shape="rectangle">
      <corners android:radius="24dp" />
      <gradient
        android:angle="315"
        android:endColor="#E00D0A14"
        android:startColor="#E01E1930" />
    </shape>
  </item>
  <item>
    <shape android:shape="rectangle">
      <corners android:radius="24dp" />
      <gradient
        android:angle="90"
        android:centerColor="#00000000"
        android:endColor="#00000000"
        android:startColor="#594015A1" />
    </shape>
  </item>
  <item>
    <shape android:shape="rectangle">
      <corners android:radius="24dp" />
      <gradient
        android:angle="315"
        android:centerColor="#00FFFFFF"
        android:endColor="#00FFFFFF"
        android:startColor="#17FFFFFF" />
    </shape>
  </item>
  <item>
    <shape android:shape="rectangle">
      <corners android:radius="24dp" />
      <solid android:color="#00000000" />
      <stroke
        android:width="1dp"
        android:color="#268B5CF6" />
    </shape>
  </item>
</layer-list>
