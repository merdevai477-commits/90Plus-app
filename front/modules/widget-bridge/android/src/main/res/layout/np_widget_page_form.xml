<?xml version="1.0" encoding="utf-8"?>
<!-- Last five results per team, then the head-to-head tally and the latest meetings -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/np_page"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:orientation="vertical"
  android:paddingStart="12dp"
  android:paddingTop="8dp"
  android:paddingEnd="12dp"
  android:paddingBottom="26dp">

  <include
    layout="@layout/np_widget_mini_header"
    android:layout_width="match_parent"
    android:layout_height="wrap_content" />

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:layout_weight="1"
    android:gravity="center_vertical"
    android:orientation="vertical">

    <LinearLayout
      android:id="@+id/np_form_home_row"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:gravity="center_vertical"
      android:orientation="horizontal">

      <ImageView
        android:id="@+id/np_form_home_logo"
        android:layout_width="18dp"
        android:layout_height="18dp"
        android:contentDescription="@null"
        android:scaleType="fitCenter" />

      <TextView
        android:id="@+id/np_form_home_name"
        android:textAlignment="viewStart"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:layout_weight="1"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="#FFFFFF"
        android:textSize="12sp"
        android:textStyle="bold" />

      <LinearLayout
        android:id="@+id/np_form_home_chips"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal" />
    </LinearLayout>

    <LinearLayout
      android:id="@+id/np_form_away_row"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="6dp"
      android:gravity="center_vertical"
      android:orientation="horizontal">

      <ImageView
        android:id="@+id/np_form_away_logo"
        android:layout_width="18dp"
        android:layout_height="18dp"
        android:contentDescription="@null"
        android:scaleType="fitCenter" />

      <TextView
        android:id="@+id/np_form_away_name"
        android:textAlignment="viewStart"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:layout_weight="1"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="#FFFFFF"
        android:textSize="12sp"
        android:textStyle="bold" />

      <LinearLayout
        android:id="@+id/np_form_away_chips"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal" />
    </LinearLayout>

    <LinearLayout
      android:id="@+id/np_h2h_row"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="10dp"
      android:background="@drawable/np_widget_chip_idle"
      android:baselineAligned="false"
      android:gravity="center_vertical"
      android:orientation="horizontal"
      android:paddingStart="10dp"
      android:paddingTop="4dp"
      android:paddingEnd="10dp"
      android:paddingBottom="4dp">

      <ImageView
        android:id="@+id/np_h2h_home_logo"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:contentDescription="@null"
        android:scaleType="fitCenter" />

      <TextView
        android:id="@+id/np_h2h_home_wins"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:textColor="#D1A4FB"
        android:textSize="15sp"
        android:textStyle="bold" />

      <TextView
        android:id="@+id/np_h2h_draws"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:gravity="center"
        android:maxLines="1"
        android:textColor="#C4C4C4"
        android:textSize="11sp" />

      <TextView
        android:id="@+id/np_h2h_away_wins"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="6dp"
        android:textColor="#FFFFFF"
        android:textSize="15sp"
        android:textStyle="bold" />

      <ImageView
        android:id="@+id/np_h2h_away_logo"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:contentDescription="@null"
        android:scaleType="fitCenter" />
    </LinearLayout>

    <LinearLayout
      android:id="@+id/np_meetings"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="4dp"
      android:orientation="vertical" />
  </LinearLayout>
</LinearLayout>
