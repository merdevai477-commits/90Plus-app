<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/np_row"
  android:layout_width="match_parent"
  android:layout_height="wrap_content"
  android:orientation="vertical"
  android:paddingTop="3dp"
  android:paddingBottom="3dp">

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <ImageView
      android:id="@+id/np_home_logo"
      android:layout_width="16dp"
      android:layout_height="16dp"
      android:contentDescription="@null"
      android:scaleType="fitCenter" />

    <TextView
      android:id="@+id/np_home_name"
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_marginStart="4dp"
      android:layout_weight="1"
      android:ellipsize="end"
      android:maxLines="1"
      android:textColor="#FFFFFF"
      android:textSize="11sp" />

    <ImageView
      android:id="@+id/np_away_logo"
      android:layout_width="16dp"
      android:layout_height="16dp"
      android:layout_marginStart="8dp"
      android:contentDescription="@null"
      android:scaleType="fitCenter" />

    <TextView
      android:id="@+id/np_away_name"
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_marginStart="4dp"
      android:layout_weight="1"
      android:ellipsize="end"
      android:maxLines="1"
      android:textColor="#FFFFFF"
      android:textSize="11sp" />
  </LinearLayout>

  <LinearLayout
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginTop="1dp"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <TextView
      android:id="@+id/np_row_time"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:maxLines="1"
      android:textColor="#8F8F8F"
      android:textSize="9sp" />

    <TextView
      android:id="@+id/np_row_status"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginStart="4dp"
      android:background="@drawable/np_widget_chip_idle"
      android:maxLines="1"
      android:paddingStart="6dp"
      android:paddingTop="1dp"
      android:paddingEnd="6dp"
      android:paddingBottom="1dp"
      android:textColor="#8C8C8C"
      android:textSize="8sp"
      android:textStyle="bold" />
  </LinearLayout>
</LinearLayout>
