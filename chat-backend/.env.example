# ─── Database ────────────────────────────────────────────────────────────────
# PostgreSQL connection string (Railway provides this automatically)
DATABASE_URL="postgresql://user:password@host:5432/dbname"

# ─── JWT ─────────────────────────────────────────────────────────────────────
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN="15m"
REFRESH_TOKEN_EXPIRES_IN="30d"

# ─── AI Provider ─────────────────────────────────────────────────────────────
# Primary model (Gemini Flash via Google AI Studio)
AI_API_KEY="your-google-ai-studio-key"
AI_BASE_URL="https://generativelanguage.googleapis.com/v1beta/openai"
AI_MODEL="gemini-2.5-flash"

# Fallback provider (OpenRouter)
OPENROUTER_API_KEY="sk-or-v1-..."

# Google AI Studio backup key
GOOGLE_AI_KEY="your-google-ai-studio-key"

# ─── Server ───────────────────────────────────────────────────────────────────
PORT=3001
FRONTEND_URL="https://your-frontend-url.com"

# ─── Daily Limit ─────────────────────────────────────────────────────────────
DAILY_MESSAGE_LIMIT=20

# ─── Cache ───────────────────────────────────────────────────────────────────
CACHE_SIMILARITY_THRESHOLD=70
CACHE_FILE_PATH=./data/qa-cache.json
