# EAS packs from the git repo root. Exclude backend/monorepo junk; keep front/.
# Docs: https://expo.fyi/eas-build-archive
# Patterns without a leading "/" match in EVERY folder — always prefix root-only rules.

# ── Backend / monorepo (not needed for Expo) ────────────────────────────────
/src/
/prisma/
/public/
/scripts/
/Backend/
/dist/
/docs/
/SETTINGS/
/PredictionKingPage-temp/
/.postman-tmp/
/.tmp-90plusNews/
/.cursor/
/.kiro/
/.vscode/
/node_modules/

# Root server / deploy configs (leading / = repo root ONLY)
/Dockerfile
/railway.toml
/nixpacks.toml
/nixpacks.json
/nodemon.json
/.eslintrc.json
/.prettierrc
/.railwayignore
/.dockerignore
/.nixpacks
/.branch-protection.json
/.postman.json
/api-football-quota-hotfix.patch
/package.json
/package-lock.json
/tsconfig.json
/tsconfig.scripts.json
/jest.config.js
/.env
/.env.example
/*.md
/_tmp_*.png
/tmp-*.txt
/app.json
/eas.json

# ── Always ignore deps & native (EAS installs / prebuilds) ──────────────────
**/node_modules/
**/.expo/
**/android/
**/ios/
**/dist/
**/build/

# ── Front local junk ────────────────────────────────────────────────────────
front/.expo-tmp-export/
front/.expo-tmp-export-check/
front/.metro-cache/
front/.expo-shared/
front/coverage/
front/docs/
front/__tests__/
front/__mocks__/
front/*.log
front/.eas-log.txt
front/tsconfig.tsbuildinfo
front/.tmp-expo-config.json
front/.env.local
front/.env.*.local
front/.env.development
front/.env.test
front/.vscode/
front/.idea/
front/.DS_Store
front/Thumbs.db
front/**/*.test.ts
front/**/*.test.tsx
front/**/*.test.js
front/**/*.spec.ts
front/**/*.spec.tsx
front/**/*.spec.js
