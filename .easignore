# EAS CLI packs from the GIT REPO ROOT and reads ONLY this file.
# front/.easignore is ignored. Docs: https://expo.fyi/eas-build-archive
# A missing rule re-uploads android/dist/node_modules and the tarball jumps to ~100MB+.
# Use explicit `front/...` paths — `**/dist` is unreliable on Windows.

# Never upload git metadata (can double archive size).
# `.git/` alone still leaked objects/pack (~22MB) on Windows.
.git/
.git/**
.git/objects/
.git/objects/**
.git/hooks/
.git/logs/
.git/refs/
.eas-archive-check/

# ── Backend / monorepo (not needed for Expo) ────────────────────────────────
/src/
/prisma/
/public/
/scripts/
/Backend/
/dist/
/docs/
/SETTINGS/
/PredictionKingPage-temp/
/.postman-tmp/
/.tmp-90plusNews/
/.cursor/
/.kiro/
/.vscode/
/tmp-validation/
/tmp-validation_health.json
/tmp-validation_metrics.json
/today-check.json

# Any node_modules tree (EAS runs npm install on the builder)
node_modules/
/node_modules/
front/node_modules/

