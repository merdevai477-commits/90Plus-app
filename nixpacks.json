{
  "phases": {
    "setup": {
      "nixPkgs": ["nodejs_20", "npm-9_x", "openssl"]
    },
    "install": {
      "cmds": [
        "npm ci --prefer-offline --no-audit",
        "npx prisma generate"
      ]
    },
    "build": {
      "cmds": [
        "npm run db:deploy",
        "npm run build"
      ]
    }
  },
  "start": {
    "cmd": "npm run start:prod"
  }
}
