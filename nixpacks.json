{
  "variables": {
    "NODE_VERSION": "20"
  },
  "phases": {
    "setup": {
      "nixPkgs": ["nodejs_20", "openssl"]
    },
    "install": {
      "cmds": [
        "npm install",
        "npx prisma generate"
      ]
    },
    "build": {
      "cmds": [
        "npm run build"
      ]
    }
  },
  "start": {
    "cmd": "npm run start:prod"
  }
}
